{
  "info": {
    "name": "AILearnMate API",
    "description": "Complete API collection for AILearnMate Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup - Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"John Teacher\",\n  \"role\": \"teacher\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Signup - Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Jane Student\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/auth/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Lectures",
      "item": [
        {
          "name": "Upload Lecture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Introduction to AI",
                  "type": "text"
                },
                {
                  "key": "courseId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Basic AI concepts",
                  "type": "text"
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5000/api/lectures/upload",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "lectures", "upload"]
            }
          }
        },
        {
          "name": "Get All Lectures",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/lectures",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "lectures"]
            }
          }
        },
        {
          "name": "Get Lectures by Course",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/lectures?courseId=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "lectures"],
              "query": [
                {
                  "key": "courseId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Lecture Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/lectures/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "lectures", "1"]
            }
          }
        },
        {
          "name": "Generate Transcript",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/lectures/1/transcribe",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "lectures", "1", "transcribe"]
            }
          }
        },
        {
          "name": "Delete Lecture",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/lectures/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "lectures", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Enroll in Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/students/enroll",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "students", "enroll"]
            }
          }
        },
        {
          "name": "Get Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/students/progress/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "students", "progress", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["health"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "teacher_token",
      "value": ""
    },
    {
      "key": "student_token",
      "value": ""
    }
  ]
}
